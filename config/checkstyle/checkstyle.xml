<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Goo Checkstyle configuration. Enforces SMELL.md conventions that are
    mechanical enough to check at source level. Complements ArchUnit
    (bytecode-level).

    Mechanical rules (fixable without design judgment) are severity=error.
    Design rules (require decomposition or refactoring) are severity=warning.
-->
<module name="Checker">
    <property name="severity" value="warning"/>
    <property name="charset" value="UTF-8"/>

    <module name="TreeWalker">

        <!-- ── Errors: mechanical, fix them ──────────────────────── -->

        <!-- Dead imports -->
        <module name="UnusedImports">
            <property name="severity" value="error"/>
        </module>

        <!-- IMPORT_DISORDER: group ordering per repo SMELL.md -->
        <module name="ImportOrder">
            <property name="severity" value="error"/>
            <property name="groups"
                value="/^com\.google/,/^com\.mercuriusxeno/,/^com\.mojang/,/^io\./,/^net\.minecraft/,/^net\.neoforged/,/^org\./,/^java\./,/^javax\./"/>
            <property name="staticGroups" value="*"/>
            <property name="separated" value="false"/>
            <property name="sortStaticImportsAlphabetically" value="true"/>
            <property name="ordered" value="true"/>
            <property name="option" value="bottom"/>
        </module>

        <!-- MAGIC: named constants for literals with semantic meaning -->
        <module name="MagicNumber">
            <property name="severity" value="error"/>
            <property name="ignoreNumbers" value="0, 1"/>
            <property name="ignoreHashCodeMethod" value="true"/>
            <property name="ignoreAnnotation" value="true"/>
            <property name="ignoreFieldDeclaration" value="true"/>
        </module>

        <!-- MAGIC: all string literals in method bodies need named constants -->
        <module name="MatchXpath">
            <property name="severity" value="error"/>
            <property name="query"
                value="//METHOD_DEF/SLIST//EXPR//STRING_LITERAL"/>
            <message key="matchxpath.match"
                value="String literal in method body - extract to a named constant"/>
        </module>

        <!-- FQN: use imports instead of fully-qualified class references -->
        <module name="MatchXpath">
            <property name="severity" value="error"/>
            <property name="query"
                value="//DOT[./IDENT[@text='net']]/DOT[./IDENT[@text='minecraft']]"/>
            <message key="matchxpath.match"
                value="Fully-qualified net.minecraft reference - use an import"/>
        </module>
        <module name="MatchXpath">
            <property name="severity" value="error"/>
            <property name="query"
                value="//DOT[./IDENT[@text='com']]/DOT[./IDENT[@text='mercuriusxeno']]"/>
            <message key="matchxpath.match"
                value="Fully-qualified com.mercuriusxeno reference - use an import"/>
        </module>

        <!-- MISSING_DOCS: classes need javadoc -->
        <module name="JavadocType">
            <property name="severity" value="error"/>
            <property name="scope" value="public"/>
        </module>

        <!-- MISSING_DOCS: all methods need javadoc -->
        <module name="JavadocMethod">
            <property name="severity" value="error"/>
            <property name="accessModifiers" value="public, protected, package, private"/>
            <property name="allowMissingParamTags" value="false"/>
            <property name="allowMissingReturnTag" value="false"/>
        </module>

        <!-- No cramming multiple statements on one line to game MethodLength -->
        <module name="OneStatementPerLine">
            <property name="severity" value="error"/>
        </module>

        <!-- Boolean expression complexity: tripwire for raw predicates -->
        <module name="BooleanExpressionComplexity">
            <property name="severity" value="error"/>
            <property name="max" value="3"/>
        </module>

        <!-- ── Warnings: design judgment required ────────────────── -->

        <!-- LONG_METHOD: 10-line hard limit per SMELL.md -->
        <module name="MethodLength">
            <property name="max" value="25"/>
            <property name="countEmpty" value="false"/>
        </module>

        <!-- Cyclomatic complexity: tripwire for tangled control flow -->
        <module name="CyclomaticComplexity">
            <property name="max" value="5"/>
        </module>


        <!-- Nesting depth: readability signal -->
        <module name="NestedIfDepth">
            <property name="max" value="2"/>
        </module>

    </module>
</module>
