{
    "_constants": {
        "base": 192,
        "storage": 9,
        "low": "2 $base",
        "medium": "3 $low",
        "high": "4 $medium",
        "ultra": "3 $high",
        "stick": {"leaf": "$base"},
        "string": {"vital": "$base"},
        "mundane_block": {"rock": "$medium"},
        "mundane_slab": "$mundane_block / 2",
        "bush": {"leaf": "$base"},
        "plank": "2 $stick",
        "log": "4 $plank",
        "fuel": {"blaze": "$log.leaf / 8"},
        "stripped_log": {
            "leaf": "$log.leaf * 3 / 4",
            "nether": "$log.leaf / 4"
        },
        "wood": "4 $log / 3",
        "stripped_wood": {
            "leaf": "$wood.leaf * 3 / 4",
            "nether": "$wood.leaf / 4"
        },
        "stem": {"leaf": "$log.leaf / 2", "nether": "$log.leaf / 2"},
        "stripped_stem": {
            "leaf": "$stem.leaf / 2",
            "nether": "$stem.nether * 3 / 2"
        },
        "hyphae": "4 $stem / 3",
        "stripped_hyphae": {
            "leaf": "$hyphae.leaf / 2",
            "nether": "$hyphae.nether * 3 / 2"
        },
        "dye": "$stick",
        "wool_base": "4 $string",
        "wool": "$wool_base + $dye",
        "magic": {"hex": "$base"},
        "life": "$base",
        "glow": {"glow":"$base"},
        "ender": {"ender":"$base"},
        "pulse": {"pulse":"$base"},
        "spawn_egg": {"vital": "$life", "aeon": "2 $life"},
        "rare": {"aeon": "$base"},
        "sherd": {"aeon": "$base", "rock": "$base"},
        "disc": {"aeon": "3 $base"},
        "coral": {"vital": "4 $base"},
        "coral_fan": "$coral / 2",
        "coral_block": "3 $coral_fan",
        "dead_coral": {"vital": "$coral.vital / 2", "nether": "$coral.vital / 2"},
        "dead_coral_fan": {"vital": "$coral_fan.vital / 2", "nether": "$coral_fan.vital / 2"},
        "dead_coral_block": {"vital": "$coral_block.vital / 2", "nether": "$coral_block.vital / 2"},
        "shroom": {"shroom": "$base"},
        "food": {"vital": 36},
        "saturation": {"vital": 12},
        "raw": {"vital": "-$food.vital", "nether": "$food.vital"},
        "nauseation": {
            "vital": "-$saturation.vital",
            "nether": "$saturation.vital"
        },
        "copper_nugget": {"metal": 288, "pulse": 288},
        "copper_ingot": "9 $copper_nugget",
        "copper_block": "9 $copper_ingot",
        "iron_nugget": {"metal": "4 $copper_nugget.metal" },
        "iron_ingot": "9 $iron_nugget",
        "iron_block": "9 $iron_ingot",
        "gold_nugget": {"metal": "4 $iron_nugget.metal", "glow": 1440},
        "gold_ingot": "9 $gold_nugget",
        "gold_block": "9 $gold_ingot",
        "netherite_scrap": {"metal": "4 $gold_ingot.metal", "aeon": "$gold_ingot.metal", "nether": "$gold_ingot.metal"},
        "nether": {"nether": "$medium"},
        "waxed": {"vital": "$medium"},
        "bottle": {"rock": "$medium"},
        "quartz": {"crystal": "$base"},
        "diamond": {"crystal": "$ultra", "aeon": "$high"},
